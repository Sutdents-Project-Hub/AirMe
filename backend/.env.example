# 複製為 backend/.env（本機）或填入 Coolify Environment Variables。
# 不得將真實值提交到 Git；所有 LIANGJIE_*、DATABASE_*、政府 API key 均只存在後端。
AI_MODE=fixture
LIANGJIE_AI_BASE_URL=https://liangjiewis.com
LIANGJIE_AI_MODEL=gemini-2.5-flash
LIANGJIE_AI_API_KEY=
# auto 會要求 OpenAI 相容的 JSON object；供應商不支援時才改為 disabled。
LIANGJIE_AI_JSON_MODE=auto
MOENV_API_KEY=
CWA_API_KEY=
ALLOWED_ORIGINS=http://localhost:8081,https://example.invalid
REQUEST_TIMEOUT_MS=8000
AI_MAX_REQUESTS_PER_MINUTE=60
AI_MAX_CONCURRENCY=4
ENVIRONMENT_MAX_REQUESTS_PER_MINUTE=120
ENVIRONMENT_MAX_CONCURRENCY=8
CONTEXT_SIGNING_SECRET=
CONTEXT_TTL_SECONDS=1800
# 使用至少 32 bytes 的隨機值，僅由後端保存；它用來雜湊資料庫中的 session token。
AUTH_SESSION_HMAC_SECRET=
# 30 天；可依正式登入裝置與風險政策調整。
AUTH_SESSION_TTL_SECONDS=2592000
# 自架開源服務的內網端點；精確地點不寫入 log、cache 或資料庫。
VALHALLA_ROUTE_URL=http://router:8002/route
PHOTON_SEARCH_URL=http://geocoder:2322/api/
ROUTING_MAX_REQUESTS_PER_MINUTE=30
ROUTING_MAX_CONCURRENCY=4
# 本機可使用 DATABASE_URL；Coolify Compose 也可拆成以下五個值。
DATABASE_URL=
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=airme
DATABASE_USER=airme
DATABASE_PASSWORD=
# live 預設為 true；fixture 本機開發可維持 false，不啟動 PostgreSQL。
DATABASE_REQUIRED=false
HOST=0.0.0.0
PORT=3000
