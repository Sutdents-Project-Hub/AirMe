# 複製為 backend/.env（本機）或填入 Coolify `airme-api` Resource 的 runtime Environment Variables。
# 不得將真實值提交到 Git；所有 LIANGJIE_*、DATABASE_*、政府 API key 均只存在後端。
AI_MODE=fixture
LIANGJIE_AI_BASE_URL=https://liangjiewis.com
LIANGJIE_AI_MODEL=gemini-2.5-flash
LIANGJIE_AI_API_KEY=
# auto 會要求 OpenAI 相容的 JSON object；供應商不支援時才改為 disabled。
LIANGJIE_AI_JSON_MODE=auto
# 僅供手動 live smoke test 使用；可複製本檔為 backend/.env.live.local，填入後執行 npm run verify:ai-live --workspace airme-api。
AI_LIVE_SMOKE_TIMEOUT_MS=20000
MOENV_API_KEY=
CWA_API_KEY=
# 沒有官方 API key 或官方來源暫時失敗時，使用明確標示的 Open-Meteo 模型資料。
# 競賽／非商業驗證可維持 true；公開商業上線前必須先確認授權方案與 attribution。
OPEN_METEO_FALLBACK_ENABLED=true
ALLOWED_ORIGINS=http://localhost:8081,https://example.invalid
REQUEST_TIMEOUT_MS=8000
AI_MAX_REQUESTS_PER_MINUTE=60
AI_MAX_CONCURRENCY=4
ENVIRONMENT_MAX_REQUESTS_PER_MINUTE=120
ENVIRONMENT_MAX_CONCURRENCY=8
CONTEXT_SIGNING_SECRET=
CONTEXT_TTL_SECONDS=1800
# 使用至少 32 bytes 的隨機值，僅由後端保存；它用來雜湊資料庫中的 session token。
AUTH_SESSION_HMAC_SECRET=
# 32-byte base64url 值；設定後才啟用帳號雲端同步，且資料以 AES-256-GCM 加密後寫入資料庫。
CLOUD_SYNC_ENCRYPTION_KEY=
# 30 天；可依正式登入裝置與風險政策調整。
AUTH_SESSION_TTL_SECONDS=2592000
# Mapbox 路線與地點搜尋只經可信任 API 呼叫；使用自訂 API runtime token（通常是沒有 secret write scope 的 pk token），不得進入 App、Web、版本控制或 log。
MAPBOX_API_BASE_URL=https://api.mapbox.com
MAPBOX_ACCESS_TOKEN=
ROUTING_MAX_REQUESTS_PER_MINUTE=30
ROUTING_MAX_CONCURRENCY=4
# 本機可使用 DATABASE_URL；Coolify API Resource 應優先使用 PostgreSQL Resource 提供的 internal DATABASE_URL。
DATABASE_URL=
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=airme
DATABASE_USER=airme
DATABASE_PASSWORD=
# live 預設為 true；fixture 本機開發可維持 false，不啟動 PostgreSQL。
DATABASE_REQUIRED=false
HOST=0.0.0.0
PORT=3000
