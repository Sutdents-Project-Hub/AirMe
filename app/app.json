{
  "expo": {
    "name": "AirMe 空氣健康小管家",
    "slug": "airme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/airme-icon.png",
    "scheme": "airme",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/airme-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4FBF7",
        "foregroundImage": "./assets/images/airme-mark.png",
        "monochromeImage": "./assets/images/airme-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/airme-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4FBF7",
          "image": "./assets/images/airme-mark.png",
          "imageWidth": 112
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
