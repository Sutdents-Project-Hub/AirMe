# 這些值會進入 App／Web bundle，不得放入 secret。
# 本機 API；Coolify Web Docker image 必須在 build 時設定完整公開 API URL，例如 https://api.example.com/api。
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api
EXPO_PUBLIC_API_TIMEOUT_MS=22000
# Mapbox public token 設計供 Web／App 地圖讀取使用；僅授予讀取地圖所需 scope，Web token 必須限制為正式網域。
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=
# 可覆寫 Mapbox 內建 raster style 的自有或已授權 MapLibre style JSON URL；此值不是 secret。
EXPO_PUBLIC_MAP_STYLE_URL=
