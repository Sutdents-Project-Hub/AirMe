FROM eclipse-temurin:21-jre-jammy

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl bzip2 tar \
  && rm -rf /var/lib/apt/lists/*

COPY docker/maps/photon-entrypoint.sh /usr/local/bin/airme-photon

WORKDIR /data
EXPOSE 2322
ENTRYPOINT ["/bin/sh", "/usr/local/bin/airme-photon"]
