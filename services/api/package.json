{
  "name": "airme-api",
  "version": "1.0.0",
  "description": "AirMe 的 Azure Functions TypeScript 後端骨架。",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "npm run clean && tsc",
    "evaluate": "npm run build && node dist/src/evaluation/run-evaluation.js evaluation/cases.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run build",
    "start": "func start"
  },
  "dependencies": {
    "@airme/contracts": "*",
    "@azure/functions": "^4.0.0",
    "@azure/identity": "^4.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "typescript": "^5.0.0",
    "rimraf": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  }
}
