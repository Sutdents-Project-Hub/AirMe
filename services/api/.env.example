# 複製到 services/api/local.settings.json 或 Azure Function App 設定。
# 不得將真實值提交到 Git。
AZURE_OPENAI_ENDPOINT=https://example.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=approved-deployment-name
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# 正式環境優先使用 Managed Identity／Entra ID。只有主辦方安全提供已輪替值時才設定：
AZURE_OPENAI_API_KEY=
AI_MODE=fixture
MOENV_API_KEY=
CWA_API_KEY=
ALLOWED_ORIGINS=http://localhost:8081,https://example.invalid
REQUEST_TIMEOUT_MS=8000
CONTEXT_SIGNING_SECRET=
CONTEXT_TTL_SECONDS=1800
APPLICATIONINSIGHTS_CONNECTION_STRING=replace-in-azure
