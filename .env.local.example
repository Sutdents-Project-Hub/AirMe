# 僅供 docker-compose.local.yml 的離線 fixture 測試使用。
# 複製為 .env.local；不得填入或提交 production secret。
POSTGRES_PASSWORD=local-airme-postgres-not-production
CONTEXT_SIGNING_SECRET=local-airme-context-secret-for-fixture-testing-only
LIANGJIE_AI_MODEL=fixture-not-used
LIANGJIE_AI_API_KEY=local-fixture-key-not-used
MOENV_API_KEY=local-fixture-key-not-used
CWA_API_KEY=local-fixture-key-not-used
