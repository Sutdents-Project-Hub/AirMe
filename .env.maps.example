# Copy to .env.maps.local before starting the optional self-hosted map overlay.
# This file contains no secret. Keep the local copy untracked.

# Canonical URL used by TileServer GL when it writes links into the style JSON.
# Change both values for an HTTPS production domain; do not leave localhost in production.
MAP_PUBLIC_BASE_URL=http://localhost:8080/maps/
MAP_ALLOWED_HOSTS=localhost

# Web can use the same Nginx host. iOS/Android require an absolute public URL, for example:
# EXPO_PUBLIC_MAP_STYLE_URL=https://maps.example.com/maps/styles/airme/style.json
EXPO_PUBLIC_MAP_STYLE_URL=/maps/styles/airme/style.json

# Valhalla builds Taiwan graph tiles from this public OpenStreetMap extract on its first start.
VALHALLA_TILE_URL=https://download.geofabrik.de/asia/taiwan-latest.osm.pbf
VALHALLA_SERVER_THREADS=2

# Planetiler needs adequate RAM while explicitly building MBTiles. It also downloads required basemap sources.
MAP_TILE_BUILD_MAX_HEAP=4g

# Photon needs a jar and a compatible prebuilt or self-built photon_data archive. Leave database URL blank
# until a Taiwan-capable source has been selected and its size, licence and update plan have been reviewed.
PHOTON_JAR_URL=https://github.com/komoot/photon/releases/download/1.2.1/photon-1.2.1.jar
PHOTON_DATABASE_URL=
PHOTON_JAVA_OPTIONS=-Xms512m -Xmx2g
