{
  "name": "airme-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/contracts",
    "backend",
    "app"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npm run build --workspace @airme/contracts && npm run build --workspace airme-api && npm run build:web --workspace airme",
    "evaluate": "npm run evaluate --workspace airme-api",
    "lint": "npm run lint --workspaces --if-present",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "^9.39.5",
    "inline-style-prefixer": "7.0.1",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "postcss-value-parser": "4.2.0"
  },
  "dependencies": {
    "react-native-svg": "15.15.4"
  }
}
